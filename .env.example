# Copy to .env and fill in for a non-default setup. Both are optional for
# local development — see comments in lib/db.ts and lib/auth.ts.

# Phase 4: point this at Postgres (or a shared libSQL/Turso db) for
# production. Left unset locally, the app uses a local file:./dev.db SQLite
# database instead.
# DATABASE_URL="postgresql://user:password@localhost:5432/ta_da_ha"

# Required in production (NODE_ENV=production) to sign session cookies.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SESSION_SECRET="replace-with-a-random-64-char-hex-string"
